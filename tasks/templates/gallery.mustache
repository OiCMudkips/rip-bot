<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{display_name}}'s deaths - rip-bot</title>
<style>
  :root {
    --bg: #f4f4f6;
    --fg: #1d1d22;
    --muted: #62626e;
    --card: #ffffff;
    --border: #d9d9e0;
    --backdrop: rgba(0, 0, 0, 0.7);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #1b1b20;
      --fg: #ececf1;
      --muted: #a0a0ab;
      --card: #26262d;
      --border: #3a3a44;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
  }
  header {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 24px 16px;
    width: calc(3 * 22.5vw + 2 * 2vw);
    margin: 0 auto;
  }
  header img {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    border: 2px solid var(--border);
  }
  header h1 { margin: 0 0 4px; font-size: 1.75rem; }
  header p { margin: 0; color: var(--muted); }
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, 22.5vw);
    gap: 2vw;
    justify-content: center;
    align-items: start;
    padding-bottom: 48px;
  }
  .thumbnail {
    display: block;
    width: 22.5vw;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    background: var(--card);
    cursor: pointer;
  }
  .thumbnail img {
    display: block;
    width: 100%;
    height: auto;
  }
  .thumbnail:focus-visible { outline: 3px solid #5865f2; outline-offset: 2px; }
  .empty { text-align: center; color: var(--muted); }
  dialog {
    width: auto;
    max-width: 95vw;
    max-height: 95vh;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card);
    color: var(--fg);
  }
  dialog::backdrop { background: var(--backdrop); }
  dialog img {
    display: block;
    width: 50vw;
    height: auto;
    border-radius: 4px;
  }
  dialog .details { width: 50vw; margin-top: 12px; }
  dialog .details p { margin: 4px 0; overflow-wrap: anywhere; }
  dialog .caption { font-size: 1.1rem; }
  dialog .meta { color: var(--muted); }
  dialog form { margin-top: 12px; text-align: right; }
  dialog button {
    padding: 6px 16px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg);
    color: var(--fg);
    font: inherit;
    cursor: pointer;
  }
</style>
</head>
<body>
<header>
  {{#profile_picture_url}}
  <img src="{{profile_picture_url}}" alt="{{display_name}}'s profile picture">
  {{/profile_picture_url}}
  <div>
    <h1>{{display_name}}</h1>
    <p>{{death_count}} deaths &middot; Generated {{generated_at}}</p>
  </div>
</header>

<main class="gallery">
  {{#deaths}}
  <button type="button" class="thumbnail" data-dialog="death-{{id}}" aria-label="Open death: {{caption}}">
    <img src="{{image_url}}" alt="{{caption}}" loading="lazy">
  </button>
  {{/deaths}}
</main>
{{^deaths}}
<p class="empty">No deaths yet.</p>
{{/deaths}}

{{#deaths}}
<dialog id="death-{{id}}">
  <img src="{{image_url}}" alt="{{caption}}" loading="lazy">
  <div class="details">
    <p class="caption">&ldquo;{{caption}}&rdquo;</p>
    <p class="meta">Reported by {{reporter_name}} on {{reported_at}}</p>
  </div>
  <form method="dialog">
    <button type="submit">Close</button>
  </form>
</dialog>
{{/deaths}}

<script>
  document.querySelectorAll("[data-dialog]").forEach(function (thumbnail) {
    thumbnail.addEventListener("click", function () {
      document.getElementById(thumbnail.dataset.dialog).showModal();
    });
  });
</script>
</body>
</html>
